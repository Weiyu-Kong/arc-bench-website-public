# Local development only. The website injects these at execution time.
# Never upload real keys or override the injected proxy URL/key in your agent.
# Python does not load this file automatically; export variables in your shell.
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=replace-with-your-local-key
# Optional vision connection; model names are selected in agent code:
VISUAL_BASE_URL=https://your-provider.example/v1
VISUAL_API_KEY=replace-with-your-local-key
# Local defaults; command-line requirements and --output-dir take priority.
ARCBENCH_TASK_TYPE=web
ARCBENCH_TASK_DIR=./sample-requirements
ARCBENCH_OUTPUT_DIR=./local-output
