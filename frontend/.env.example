# Browser-safe Hackathon Auth configuration. The publishable/anon key is not a
# server secret; its access must remain protected by Supabase Row Level Security.
# Never put SUPABASE_SERVICE_ROLE_KEY or a database password in this file.
VITE_HACKATHON_SUPABASE_URL=
VITE_HACKATHON_SUPABASE_ANON_KEY=

# Development-only Vite proxy destination. Production should route /api and
# /paper-assets to the API service through the public reverse proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional API origin for a separately deployed frontend. Leave empty when
# frontend and API share an origin and the reverse proxy handles /api.
# Example: https://api.example.com/api
VITE_API_BASE=
